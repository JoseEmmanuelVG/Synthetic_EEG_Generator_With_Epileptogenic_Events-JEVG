{
  "name": "JavaScript Portfolio (Node 20)",
  "image": "mcr.microsoft.com/devcontainers/node:20",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "npm ci || npm install",
  "postAttachCommand": {
    "server": "npm start"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.copilot"
      ],
      "settings": {
        "emmet.includeLanguages": { "javascript": "javascriptreact" },
        "emmet.triggerExpansionOnTab": true
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "portsAttributes": {
    "3000": { "label": "App", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [3000]
}
